# Токен Telegram-бота (получите у @BotFather)
BOT_TOKEN=your_bot_token_here

# Безопасность: ID пользователей, которым разрешён доступ (через запятую)
# Оставьте пустым для открытого доступа
# Пример: ALLOWED_USER_IDS=123456789,987654321
ALLOWED_USER_IDS=

# Rate limiting: максимум договоров на пользователя
MAX_CONTRACTS_PER_HOUR=10
MAX_CONTRACTS_PER_DAY=50

# Уровень логирования (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
